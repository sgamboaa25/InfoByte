---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Términos de Uso - InfoByte"
  description="Términos y condiciones de uso del sitio web InfoByte."
>
  <main class="container legal-content">
    <h1>Términos de Uso</h1>
    <p class="last-updated">Última actualización: 15 de Mayo de 2024</p>

    <section>
      <h2>1. Aceptación de los Términos</h2>
