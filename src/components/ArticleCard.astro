---
export interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
  slug: string;
  image?: string;
}

const { title, description, date, category, slug, image } = Astro.props;
---

<article class="card article-card">
  {image && (
    <a href={`/blog/${slug}`} class="card-media">
      <img src={image} alt={title} class="card-img" loading="lazy" />
    </a>
  )}
  <div class="card-body">
    <div class="card-top">
      <a href={`/categoria/${category.toLowerCase()}`} class="card-category">{category}</a>
      <time class="card-date" datetime={date}>{date}</time>
    </div>

    <h3 class="card-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>

    <p class="card-excerpt">{description}</p>

    <a href={`/blog/${slug}`} class="card-cta">Leer más</a>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 350px;
    height: 100%;
    margin-left: auto;
    margin-right: auto;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .article-card:hover {
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .card-media {
    display: block;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }

  /* Fila superior: categoría a la izquierda, fecha a la derecha */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .card-category {
    display: inline-block;
    min-width: 0;
    padding: 0.3rem 0.8rem;
    background-color: var(--color-primary-hover);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 9999px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: var(--transition-base);
  }

  .card-category:hover {
    background-color: var(--color-primary);
    color: #ffffff;
    text-decoration: none;
  }

  .card-date {
    flex-shrink: 0;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .card-title {
    margin: 0;
    font-size: var(--font-size-2xl);
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: calc(2 * 1.4 * var(--font-size-2xl));
  }

  .card-title a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  .card-excerpt {
    flex: 1;
    margin: 12px 0 20px;
    color: #444444;
    font-size: 0.95rem;
    line-height: 1.6;
    text-align: justify;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  /* Botón sutil en pastilla de borde fino, anclado al final */
  .card-cta {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.4rem 0.9rem;
    background-color: transparent;
    border: 1px solid var(--color-primary);
    border-radius: 9999px;
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: var(--transition-base);
  }

  .card-cta:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
    text-decoration: none;
  }
</style>
