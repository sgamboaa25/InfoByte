---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
  image?: string;
  author?: string;
}

const { title, description, date, category, image, author = 'InfoByte Team' } = Astro.props;

// Estimate reading time (rough calc: 200 words per minute)
// Since we don't have the content string directly here in the layout props easily,
// we'll just mock it or assume a generic 5 min read for this placeholder layout.
const readingTime = "5 min de lectura";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <SEOHead 
      title={title} 
      description={description} 
      ogImage={image} 
      isArticle={true}
      articleDate={date}
    />
  </head>
  <body>
    <Header />
    
    <main class="container py-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Article Content -->
        <div class="lg:col-span-2">
          <article class="article-content">
            <header class="mb-8">
              <a href={`/categoria/${category.toLowerCase()}`} class="badge mb-4">{category}</a>
              <h1 class="mb-4">{title}</h1>
              
              <div class="flex items-center gap-4 text-sm text-secondary mb-6 pb-6 border-b">
                <span>Por <strong>{author}</strong></span>
                <span>&bull;</span>
                <time datetime={date}>{date}</time>
                <span>&bull;</span>
                <span>{readingTime}</span>
              </div>
              
              {image && <img src={image} alt={title} class="w-full rounded-lg mb-8" />}
            </header>

            <!-- Top Article Ad -->
            <AdSlot slot="3333333333" format="horizontal" className="mb-8" />
            
            <div class="prose max-w-none">
              <!-- Content slots will go here -->
              <slot />
              
              <!-- NOTE: In a real Astro MDX setup, to inject an ad after 2nd paragraph, -->
              <!-- you might write a custom rehype plugin or split the content manually. -->
              <!-- For now, we represent where the content is rendered. -->
            </div>

            <!-- Bottom Article Ad -->
            <AdSlot slot="4444444444" format="horizontal" className="mt-12 mb-8" />
            
          </article>

          <!-- Related Articles Placeholder -->
          <section class="mt-12 pt-8 border-t">
            <h2 class="mb-6">Artículos Relacionados</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Use ArticleCard components here in the future -->
              <p class="text-secondary italic">No hay artículos relacionados todavía.</p>
            </div>
          </section>
        </div>

        <!-- Right Sidebar -->
        <div class="lg:col-span-1">
          <Sidebar />
        </div>
      </div>
    </main>

    <Footer />
    <CookieBanner />
  </body>
</html>

<style>
  .py-8 {
    padding-top: var(--spacing-8);
    padding-bottom: var(--spacing-8);
  }
  .lg\:col-span-2 {
    grid-column: span 2 / span 2;
  }
  .lg\:col-span-1 {
    grid-column: span 1 / span 1;
  }
  .text-secondary {
    color: var(--color-text-secondary);
  }
  .border-b {
    border-bottom: 1px solid var(--color-border);
  }
  .border-t {
    border-top: 1px solid var(--color-border);
  }
  .rounded-lg {
    border-radius: var(--border-radius-lg);
  }
</style>
